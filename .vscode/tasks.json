{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: configure debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "STM32: build debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "STM32: configure debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "STM32: clean build debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "debug",
        "--clean-first"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "STM32: configure debug",
      "problemMatcher": "$gcc"
    },
    {
      "label": "STM32: configure release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "STM32: build release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "STM32: configure release",
      "problemMatcher": "$gcc"
    },
    {
      "label": "STM32: flash debug",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/flash-debug.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "STM32: build debug",
      "problemMatcher": []
    },
    {
      "label": "STM32: open CubeMX",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/open-cubemx.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
